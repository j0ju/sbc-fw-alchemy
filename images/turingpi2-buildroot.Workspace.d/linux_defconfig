CONFIG_MAGIC_SYSRQ=y
# Keep the full SysRq command set, including reboot and power off. On a board
# with no watchdog, a serial reset is the only remedy short of walking to the
# rack, and giving that up would be a worse trade than the risk it carries.
#
# The risk is real, though: a BREAK on console=ttyS0 triggers SysRq and the
# next byte is the command, and USB-serial adapters assert BREAK whenever a
# port is opened, closed or reconfigured. The kernel's own help for
# MAGIC_SYSRQ_SERIAL describes exactly this -- "a disconnected TTL level serial
# which can generate some garbage that can lead to spurious false sysrq
# detects".
#
# So guard it instead of removing it. With a sequence set, BREAK alone does
# nothing: the sequence must follow it before any command is accepted. Garbage
# cannot produce that, and a person typing it means it.
#
#   BREAK, then "sysrq", then the command key. `b` reboots, `o` powers off,
#   `w` shows blocked tasks, `m` shows memory.
CONFIG_MAGIC_SYSRQ_DEFAULT_ENABLE=0x1
CONFIG_MAGIC_SYSRQ_SERIAL=y
CONFIG_MAGIC_SYSRQ_SERIAL_SEQUENCE="sysrq"
CONFIG_DEBUG_FS=y
CONFIG_ATOMIC64_SELFTEST=y

