# Downloads. On 2026-09-06 ftpmirror.gnu.org answered "504 Gateway Time-out"
# after ~60 s, and wget retries three times (BR2_WGET="wget -nd -t 3"), so
# fifteen GNU tarballs cost 2020 s of a 6772 s CI build before Buildroot fell
# back to sources.buildroot.net -- which serves every hashed tarball from a
# CDN. Ask that mirror first (it is tried as <site>/<pkg>/<file>); a miss
# there still falls through to the package's own site.
BR2_PRIMARY_SITE="https://sources.buildroot.net"

# Top-level parallel build (SQU-104 phase 2): every package gets its own
# host/target staging so independent packages build at the same time instead
# of strictly in sequence. Requires `make -j` from scripts/build.sh; a
# package with an undeclared dependency shows up as a build failure here
# rather than working by accident.
BR2_PER_PACKAGE_DIRECTORIES=y

# Kernel
#
# Pin the version. Without BR2_LINUX_KERNEL_CUSTOM_VERSION the kernel
# follows Buildroot's "latest" default, so the board's kernel changed
# silently with every Buildroot bump -- that is how it ended up on
# 6.8.12, which is not an LTS series and is out of support. Name the
# version here so a Buildroot upgrade and a kernel upgrade are two
# separate, reviewable changes.
#
# 6.12 is a longterm series (maintained to Dec 2026 at least); .109 is
# its current point release. Buildroot 2025.02.17 defaults to .104, and
# linux/linux.hash lists only the release each Buildroot was cut against,
# so moving off .104 also moves off the one sum Buildroot has for us. It
# will not complain: linux.mk puts a custom-version kernel tarball in
# BR_NO_CHECK_HASH_FOR, so a missing sum means the kernel is downloaded
# unverified, quietly. buildroot_patches/0003 supplies ours, from
# kernel.org's signed sha256sums.asc. A kernel bump is therefore two
# files: this one and that patch.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.12.109"
# The headers series must be named too. BR2_TOOLCHAIN_HEADERS_AT_LEAST_*
# is selected by BR2_LINUX_KERNEL_LATEST_VERSION, NOT by a custom version
# (linux/Config.in), so with BR2_KERNEL_HEADERS_AS_KERNEL a custom version
# alone leaves the series to a kconfig default. On 2024.05.1 that default
# happens to land on 6.8; on a newer Buildroot it does not, and the failure
# is silent -- headers fall back to "2.6", which makes glibc unselectable,
# so the toolchain quietly becomes uclibc without wchar or locale and eight
# packages (dosfstools, f2fs-tools, iproute2, libgpiod, parted, ...) vanish
# from the image. Name the series so the pin is a pin.
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_6_12=y
# gcc 13 is this Buildroot release's default and was never named here. It is
# named now because CI's prebuilt toolchain (tp2bmc/configs/
# ci-external-toolchain.fragment) must state the gcc it carries, and
# tests/toolchain-fragment.sh checks that statement against THIS file. A
# default cannot be checked; a line can. No change to what is built.
BR2_GCC_VERSION_13_X=y
BR2_LINUX_KERNEL_PATCH="$(BR2_EXTERNAL_TP2BMC_PATH)/patches/linux"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_TP2BMC_PATH)/board/tp2bmc/linux_defconfig"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_PATH="$(BR2_EXTERNAL_TP2BMC_PATH)/board/tp2bmc/sun8i-t113s-turing-pi2.dtsi $(BR2_EXTERNAL_TP2BMC_PATH)/board/tp2bmc/sun8i-t113s-turing-pi2-v2.4.dts $(BR2_EXTERNAL_TP2BMC_PATH)/board/tp2bmc/sun8i-t113s-turing-pi2-v2.5.1.dts $(BR2_EXTERNAL_TP2BMC_PATH)/board/tp2bmc/sun8i-t113s-turing-pi2-v2.5.dts $(BR2_EXTERNAL_TP2BMC_PATH)/board/tp2bmc/sun8i-t113s-turing-pi2-locked.dts"
BR2_LINUX_KERNEL_DTB_KEEP_DIRNAME=y
BR2_LINUX_KERNEL_DTB_OVERLAY_SUPPORT=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y
BR2_KERNEL_HEADERS_AS_KERNEL=y

